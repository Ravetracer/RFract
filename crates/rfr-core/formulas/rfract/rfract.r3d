comment {
  RFract built-in 3D formulas (UFM syntax, .r3d).

  A 3D formula iterates the real variables x, y, z, which start at the point (#px, #py,
  #pz). #cx, #cy, #cz are the constant: the point itself, or the seed in Julia mode. The loop
  runs while the bailout holds, at most the layer's iterations. The distance to the surface
  comes from the derivatives of the orbit: logarithmic by default (powers), linear with
  distance = "linear" (folds). bound is the radius of a sphere that holds the object.
}

Mandelbulb {
; z -> z^n + c in spherical coordinates: the 3D analogue of the Mandelbrot set.
loop:
  float r = sqrt(x * x + y * y + z * z)
  float theta = 0
  if r > 1e-12
    theta = acos(z / r) * @power
  endif
  float phi = atan2(x + flip(y)) * @power
  float rn = r ^ @power
  x = rn * sin(theta) * cos(phi) + #cx
  y = rn * sin(theta) * sin(phi) + #cy
  z = rn * cos(theta) + #cz
bailout:
  x * x + y * y + z * z < 4
default:
  title = "Mandelbulb"
  bound = 2
  float param power
    caption = "Power"
    default = 8
    min = 2
    max = 16
    hint = "The exponent n (8: the classic bulb)."
  endparam
}

BurningBulb {
; The Mandelbulb of the absolute coordinates: sharp ridges like the Burning Ship.
loop:
  x = abs(x)
  y = abs(y)
  float r = sqrt(x * x + y * y + z * z)
  float theta = 0
  if r > 1e-12
    theta = acos(z / r) * @power
  endif
  float phi = atan2(x + flip(y)) * @power
  float rn = r ^ @power
  x = rn * sin(theta) * cos(phi) + #cx
  y = rn * sin(theta) * sin(phi) + #cy
  z = rn * cos(theta) + #cz
bailout:
  x * x + y * y + z * z < 4
default:
  title = "Burning bulb"
  bound = 2
  float param power
    caption = "Power"
    default = 8
    min = 2
    max = 16
    hint = "The exponent n."
  endparam
}

Bristorbrot {
; x' = x² − y² − z², y' = y (2x − z), z' = z (2x + y), plus c: a quadratic 3D map with
; swirling bulbs.
loop:
  float nx = x * x - y * y - z * z + #cx
  float ny = y * (2 * x - z) + #cy
  z = z * (2 * x + y) + #cz
  x = nx
  y = ny
bailout:
  x * x + y * y + z * z < 16
default:
  title = "Bristorbrot"
  bound = 2.5
}

Mandelbox {
; Box fold, sphere fold and a scale: cubes full of folded detail.
loop:
  if x > 1
    x = 2 - x
  elseif x < -1
    x = -2 - x
  endif
  if y > 1
    y = 2 - y
  elseif y < -1
    y = -2 - y
  endif
  if z > 1
    z = 2 - z
  elseif z < -1
    z = -2 - z
  endif
  float r2 = x * x + y * y + z * z
  float k = 1
  if r2 < @minradius * @minradius
    k = 1 / (@minradius * @minradius)
  elseif r2 < 1
    k = 1 / r2
  endif
  x = x * k * @scale + #cx
  y = y * k * @scale + #cy
  z = z * k * @scale + #cz
bailout:
  x * x + y * y + z * z < 1e8
default:
  title = "Mandelbox"
  distance = "linear"
  bound = 11
  float param scale
    caption = "Scale"
    default = 2
    min = -3
    max = 3
    hint = "The scale after the folds (2: the classic box)."
  endparam
  float param minradius
    caption = "Minimum radius"
    default = 0.5
    min = 0.05
    max = 1
    hint = "Inside this radius the sphere fold scales by a constant."
  endparam
}
