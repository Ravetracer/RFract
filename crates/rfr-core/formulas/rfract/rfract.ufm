comment {
  RFract built-in formulas (UFM syntax).

  RFract extensions: #ismand is true in Mandelbrot mode (the parameter plane) and false in
  Julia mode; #c is the pixel in Mandelbrot mode and the seed in Julia mode. Formulas that read
  them get the Mandelbrot/Julia switch in the layer settings.

  |z| is the squared magnitude, so a bailout of 1e8 means a radius of 1e4.
}

Mandelbrot {
; z -> z^power + c with an integer power.
init:
  if #ismand
    z = @start
  else
    z = #pixel
  endif
loop:
  z = z^@power + #c
bailout:
  |z| <= @bailout
default:
  title = "Mandelbrot"
  center = (-0.5, 0)
  magn = 1
  maxiter = 500
  int param power
    caption = "Power"
    default = 2
    min = 2
    max = 16
    hint = "Exponent of z. 2 is the classic set, higher powers give more bulbs around the center."
  endparam
  complex param start
    caption = "Start value"
    default = (0, 0)
    hint = "Value of z before the first iteration (Mandelbrot mode only). Moving it away from 0 distorts the set."
  endparam
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude). Large values give smoother colors."
  endparam
}

Multibrot {
; z -> z^power + c with a real power.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  z = z^@power + #c
bailout:
  |z| <= @bailout
default:
  title = "Multibrot (real power)"
  center = (0, 0)
  magn = 0.8
  maxiter = 300
  float param power
    caption = "Power"
    default = 2.5
    min = -8
    max = 16
    hint = "Exponent of z; non-integer powers cut the set along the negative real axis."
  endparam
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

BurningShip {
; Absolute values of both parts before squaring. The plane is mirrored (conjugated) so the
; ship stands upright with the imaginary axis pointing up.
init:
  if #ismand
    z = 0
  else
    z = conj(#pixel)
  endif
loop:
  z = sqr(abs(z)) + conj(#c)
bailout:
  |z| <= @bailout
default:
  title = "Burning Ship"
  center = (-0.4, 0.5)
  magn = 0.8
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Tricorn {
; Also called Mandelbar: the conjugate of z is raised to the power.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  z = conj(z)^@power + #c
bailout:
  |z| <= @bailout
default:
  title = "Tricorn (Mandelbar)"
  center = (-0.3, 0)
  magn = 0.9
  maxiter = 500
  int param power
    caption = "Power"
    default = 2
    min = 2
    max = 16
    hint = "Exponent of the conjugate."
  endparam
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Celtic {
; z² with the absolute value of its real part.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  w = sqr(z)
  z = (abs(real(w)), imag(w)) + #c
bailout:
  |z| <= @bailout
default:
  title = "Celtic"
  center = (-0.5, 0)
  magn = 0.9
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Buffalo {
; Absolute values of both parts of z².
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  z = abs(sqr(z)) - abs(z) * @damping + #c
bailout:
  |z| <= @bailout
default:
  title = "Buffalo"
  center = (-0.5, -0.4)
  magn = 0.8
  maxiter = 500
  float param damping
    caption = "Damping"
    default = 1
    min = 0
    max = 2
    hint = "How much of |z| is subtracted each iteration (1: the classic Buffalo, 0: plain absolute square)."
  endparam
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Perpendicular {
; Perpendicular Mandelbrot: the absolute real part enters the imaginary part.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  x = real(z)
  y = imag(z)
  z = (x*x - y*y, -2 * abs(x) * y) + #c
bailout:
  |z| <= @bailout
default:
  title = "Perpendicular Mandelbrot"
  center = (-0.5, 0)
  magn = 0.9
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Phoenix {
; z -> z² + Re(c) + Im(c) · previous z.
init:
  y = (0, 0)
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  t = z
  z = sqr(z) + real(#c) + imag(#c) * y
  y = t
bailout:
  |z| <= @bailout
default:
  title = "Phoenix"
  center = (0, 0)
  magn = 0.8
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Lambda {
; The logistic map z -> c z (1 - z).
init:
  if #ismand
    z = 0.5
  else
    z = #pixel
  endif
loop:
  z = #c * z * (1 - z)
bailout:
  |z| <= @bailout
default:
  title = "Lambda (logistic)"
  center = (1, 0)
  magn = 0.5
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Magnet1 {
; Magnet type I: escapes to infinity or converges to 1.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  z = sqr((sqr(z) + #c - 1) / (2*z + #c - 2))
bailout:
  |z| <= @bailout && |z - 1| > @epsilon
default:
  title = "Magnet I"
  center = (1.4, 0)
  magn = 0.5
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e4
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
  float param epsilon
    caption = "Convergence"
    default = 1e-8
    min = 0
    hint = "The orbit stops once |z - 1|² falls below this value (it found the fixed point 1)."
  endparam
}

Magnet2 {
; Magnet type II.
init:
  if #ismand
    z = 0
  else
    z = #pixel
  endif
loop:
  c1 = #c - 1
  c2 = #c - 2
  z = sqr((z*z*z + 3*c1*z + c1*c2) / (3*sqr(z) + 3*c2*z + c1*c2 + 1))
bailout:
  |z| <= @bailout && |z - 1| > @epsilon
default:
  title = "Magnet II"
  center = (1, 0)
  magn = 0.5
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e4
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
  float param epsilon
    caption = "Convergence"
    default = 1e-8
    min = 0
    hint = "The orbit stops once |z - 1|² falls below this value."
  endparam
}

Newton {
; Newton's method for z^power = 1: every point flows to one of the roots.
init:
  z = #pixel
loop:
  z = z - @relax * (z^@power - 1) / (@power * z^(@power - 1))
bailout:
  |z - #zprev| > @epsilon
default:
  title = "Newton"
  center = (0, 0)
  magn = 0.7
  maxiter = 200
  int param power
    caption = "Power"
    default = 3
    min = 2
    max = 12
    hint = "Degree of the polynomial z^n - 1: the number of roots."
  endparam
  complex param relax
    caption = "Relaxation"
    default = (1, 0)
    hint = "Step factor. 1 is Newton's method; other values twist and enlarge the basins."
  endparam
  float param epsilon
    caption = "Convergence"
    default = 1e-8
    min = 0
    hint = "The orbit stops once a step |Δz|² is smaller than this value."
  endparam
}

Nova {
; Relaxed Newton for z^power - 1 plus c.
init:
  if #ismand
    z = 1
  else
    z = #pixel
  endif
loop:
  z = z - @relax * (z^@power - 1) / (@power * z^(@power - 1)) + #c
bailout:
  |z - #zprev| > @epsilon
default:
  title = "Nova"
  center = (-0.4, 0)
  magn = 0.8
  maxiter = 200
  int param power
    caption = "Power"
    default = 3
    min = 2
    max = 12
    hint = "Degree of the polynomial."
  endparam
  complex param relax
    caption = "Relaxation"
    default = (1, 0)
    hint = "Step factor of the Newton step."
  endparam
  float param epsilon
    caption = "Convergence"
    default = 1e-8
    min = 0
    hint = "The orbit stops once a step |Δz|² is smaller than this value."
  endparam
}

Spider {
; The constant follows the orbit: c -> c/2 + z.
init:
  k = #c
  z = #pixel
loop:
  z = sqr(z) + k
  k = k * 0.5 + z
bailout:
  |z| <= @bailout
default:
  title = "Spider"
  center = (-0.4, 0)
  magn = 0.8
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Manowar {
; z -> z² + previous z + c.
init:
  z = #pixel
  y = z
loop:
  t = z
  z = sqr(z) + y + #c
  y = t
bailout:
  |z| <= @bailout
default:
  title = "Manowar"
  center = (-0.3, 0)
  magn = 1.2
  maxiter = 500
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Barnsley1 {
; z -> (z ∓ 1) c, the sign chosen by the real part of z.
init:
  z = #pixel
loop:
  if real(z) >= 0
    z = (z - 1) * #c
  else
    z = (z + 1) * #c
  endif
bailout:
  |z| <= @bailout
default:
  title = "Barnsley 1"
  center = (0, 0)
  magn = 0.6
  maxiter = 300
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Barnsley2 {
; Like Barnsley 1, the sign chosen by Re(z) Im(c) + Re(c) Im(z).
init:
  z = #pixel
loop:
  if real(z) * imag(#c) + real(#c) * imag(z) >= 0
    z = (z - 1) * #c
  else
    z = (z + 1) * #c
  endif
bailout:
  |z| <= @bailout
default:
  title = "Barnsley 2"
  center = (0, 0)
  magn = 0.6
  maxiter = 300
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Barnsley3 {
; z² - 1, plus Re(z) c for points left of the imaginary axis.
init:
  z = #pixel
loop:
  x = real(z)
  y = imag(z)
  if x > 0
    z = (x*x - y*y - 1, 2*x*y)
  else
    z = (x*x - y*y - 1 + real(#c)*x, 2*x*y + imag(#c)*x)
  endif
bailout:
  |z| <= @bailout
default:
  title = "Barnsley 3"
  center = (0, 0)
  magn = 0.6
  maxiter = 300
  float param bailout
    caption = "Bailout"
    default = 1e8
    min = 4
    hint = "Escape threshold of |z|² (squared magnitude)."
  endparam
}

Pixel {
; z is the point itself and the orbit ends after one step: the coloring sees the plane
; directly (use it with transformations and coloring formulas).
init:
  z = #pixel
loop:
  z = z
bailout:
  false
default:
  title = "Pixel (plane only)"
  center = (0, 0)
  magn = 1
  maxiter = 1
}

Lyapunov {
; Markus–Lyapunov fractal: the logistic map x → r·x·(1 − x) with r switching between a (the
; point's x) and b (its y) after a sequence of A and B. z holds the Lyapunov exponent λ:
; negative where the map settles (stable), positive where it is chaotic. Color it with the
; Lyapunov coloring (inside).
init:
  int seq[16]
  int len = 2
  seq[0] = 1
  seq[1] = 0
  if @sequence == 1
    ; AABAB
    len = 5
    seq[0] = 1
    seq[1] = 1
    seq[2] = 0
    seq[3] = 1
    seq[4] = 0
  elseif @sequence == 2
    ; BBBBBBAAAAAA (Zircon Zity)
    len = 12
    int k = 0
    while k < 12
      seq[k] = 0
      if k >= 6
        seq[k] = 1
      endif
      k = k + 1
    endwhile
  elseif @sequence == 3
    ; ABBBA
    len = 5
    seq[0] = 1
    seq[1] = 0
    seq[2] = 0
    seq[3] = 0
    seq[4] = 1
  elseif @sequence == 4
    ; AAAAAABBBBBB
    len = 12
    int k = 0
    while k < 12
      seq[k] = 1
      if k >= 6
        seq[k] = 0
      endif
      k = k + 1
    endwhile
  endif
  float x = 0.5
  float lsum = 0
  int n = 0
  z = 0
loop:
  float r = imag(#pixel)
  if seq[n % len] == 1
    r = real(#pixel)
  endif
  x = r * x * (1 - x)
  if n >= @warmup
    lsum = lsum + log(abs(r * (1 - 2 * x)) + 1e-30)
    z = lsum / (n - @warmup + 1)
  endif
  n = n + 1
bailout:
  true
default:
  title = "Lyapunov"
  center = (3.4, 3.4)
  magn = 2.5
  maxiter = 400
  insidecoloring = "rfract-coloring:Lyapunov"
  int param sequence
    caption = "Sequence"
    enum = "AB" "AABAB" "BBBBBBAAAAAA" "ABBBA" "AAAAAABBBBBB"
    default = 0
    hint = "The order in which r takes the values a (A) and b (B)."
  endparam
  int param warmup
    caption = "Warm-up"
    default = 50
    hint = "Iterations before the exponent is measured."
  endparam
}

Truchet {
; Truchet tiles: every square of the grid holds two quarter circles in one of two
; orientations, chosen at random by the square. z is the distance to the nearest arc.
init:
  complex p = #pixel / @size
  float fx = floor(real(p))
  float fy = floor(imag(p))
  float u = real(p) - fx
  float v = imag(p) - fy
  int ix = round(fx)
  int iy = round(fy)
  int h = random(ix * 7919 + iy * 104729 + @seed)
  if h % 2 == 0
    u = 1 - u
  endif
  float d1 = abs(cabs((u, v)) - 0.5)
  float d2 = abs(cabs((u - 1, v - 1)) - 0.5)
  z = (min(d1, d2) * 2, 0)
loop:
  z = z
bailout:
  false
default:
  title = "Truchet tiles"
  center = (0, 0)
  magn = 0.5
  maxiter = 1
  outsidecoloring = "rfract-coloring:ZValue"
  float param size
    caption = "Tile size"
    default = 0.5
  endparam
  int param seed
    caption = "Pattern"
    default = 1
    hint = "Another number gives another arrangement of the tiles."
  endparam
}

Carpet {
; Sierpinski carpet: the square is cut into 3 × 3 and the middle removed, again in every part.
; Points in a removed square escape at the step that removed it.
init:
  z = (#pixel + (1.5, 1.5)) / 3
loop:
  float u = real(z) * 3
  float v = imag(z) * 3
  float a = floor(u)
  float b = floor(v)
  if a == 1 && b == 1
    z = (1e10, 0)
  else
    z = (u - a, v - b)
  endif
bailout:
  |z| < 100 && real(#pixel) > -1.5 && real(#pixel) < 1.5 && imag(#pixel) > -1.5 && imag(#pixel) < 1.5
default:
  title = "Sierpinski carpet"
  center = (0, 0)
  magn = 0.95
  maxiter = 8
}

RootFinding {
; Root finding for a polynomial p(z) = c0 + c1·z + … + c6·z⁶: Newton, Halley or Schröder steps
; (relaxed), optionally Nova (+ c). Points converge to the roots; the coloring shows how fast.
init:
  if @nova && #ismand
    z = @start
  else
    z = #pixel
  endif
loop:
  complex p = @c6
  complex d = 0
  complex dd = 0
  p = p * z + @c5
  p = p * z + @c4
  p = p * z + @c3
  p = p * z + @c2
  p = p * z + @c1
  p = p * z + @c0
  d = 6 * @c6
  d = d * z + 5 * @c5
  d = d * z + 4 * @c4
  d = d * z + 3 * @c3
  d = d * z + 2 * @c2
  d = d * z + @c1
  dd = 30 * @c6
  dd = dd * z + 20 * @c5
  dd = dd * z + 12 * @c4
  dd = dd * z + 6 * @c3
  dd = dd * z + 2 * @c2
  complex step = p / d
  if @method == 1
    ; Halley
    step = 2 * p * d / (2 * d * d - p * dd)
  elseif @method == 2
    ; Schröder (multiple roots)
    step = p * d / (d * d - p * dd)
  endif
  if @nova
    z = z - @relax * step + #c
  else
    z = z - @relax * step
  endif
bailout:
  |z - #zprev| > @tolerance
default:
  title = "Root finding (polynomial)"
  center = (0, 0)
  magn = 0.75
  maxiter = 100
  int param method
    caption = "Method"
    enum = "Newton" "Halley" "Schröder"
    default = 0
    hint = "Newton: p/p'. Halley converges faster; Schröder also at multiple roots."
  endparam
  complex param c0
    caption = "c0"
    default = (-1, 0)
  endparam
  complex param c1
    caption = "c1 (z)"
    default = (0, 0)
  endparam
  complex param c2
    caption = "c2 (z²)"
    default = (0, 0)
  endparam
  complex param c3
    caption = "c3 (z³)"
    default = (1, 0)
  endparam
  complex param c4
    caption = "c4 (z⁴)"
    default = (0, 0)
  endparam
  complex param c5
    caption = "c5 (z⁵)"
    default = (0, 0)
  endparam
  complex param c6
    caption = "c6 (z⁶)"
    default = (0, 0)
  endparam
  complex param relax
    caption = "Relaxation"
    default = (1, 0)
    hint = "Step factor (1: plain steps; other values twist the basins)."
  endparam
  bool param nova
    caption = "Nova"
    default = false
    hint = "Add the point after every step (Nova fractal; Mandelbrot mode starts at the start value)."
  endparam
  complex param start
    caption = "Nova start"
    default = (1, 0)
  endparam
  float param tolerance
    caption = "Tolerance"
    default = 1e-12
    hint = "The orbit stops when a step moves z less than this (squared)."
  endparam
}
