#!/bin/sh
# RFract AppImage entry point. Without arguments (or with a document) it starts the program;
# "cli" as the first argument runs the command line tool instead:
#   ./RFract-x86_64.AppImage cli info
HERE="$(dirname "$(readlink -f "$0")")"
if [ "$1" = "cli" ]; then
    shift
    exec "$HERE/usr/bin/rfr-cli" "$@"
fi
case "$(basename "${ARGV0:-$0}")" in
    rfr-cli*) exec "$HERE/usr/bin/rfr-cli" "$@" ;;
esac
exec "$HERE/usr/bin/rfr-app" "$@"
